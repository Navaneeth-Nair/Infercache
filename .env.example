# InferCache Configuration

# Server
HOST=0.0.0.0
PORT=8080

# Upstream LLM Endpoint (OpenAI / Ollama / vLLM / LocalAI)
UPSTREAM_URL=https://api.openai.com/v1/chat/completions
# UPSTREAM_API_KEY=sk-...

# CORS: comma-separated list of allowed browser origins.
# Leave unset (or empty) to deny all browser cross-origin requests (safest for a backend proxy).
# Set to your frontend's origin(s) when InferCache is accessed from a browser.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com

# Semantic Matching Threshold (0.0 to 1.0)
# 0.95 ensures near-exact semantic equivalence required for safe LLM response reuse
SIMILARITY_THRESHOLD=0.95

# Vector Backend: "memory" (built-in, <50MB RAM) or "qdrant" (Docker / Cloud, <150MB RAM)
VECTOR_BACKEND=memory
QDRANT_URL=http://localhost:6334
QDRANT_COLLECTION=infercache

# Local HuggingFace Embedding Model (<45MB FP16 footprint on CPU)
MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
